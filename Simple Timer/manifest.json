{
  "manifest_version": 3,
  "name": "Simple Timer",
  "version": "1.0.0",
  "description": "This Simple Timer shows your curent local time and has a timer which tracks your total chrome usage time(automatically resets the next day)",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_icon": {
      "16": "icon.png",
      "24": "icon.png",
      "32": "icon.png"
    },
    "default_title": "Simple Timer Action",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "permissions": ["storage", "alarms", "notifications"],
  "background": {
    "service_worker": "background.js"
  }
}
